# Streamlit executive dashboard (dashboard service)
FROM python:3.12-slim

RUN pip install --no-cache-dir pandas numpy pyarrow streamlit plotly PyYAML

WORKDIR /opt/app
COPY common/ ./common/
COPY dashboard/ ./dashboard/

ENV PYTHONUNBUFFERED=1
EXPOSE 8501
CMD ["streamlit", "run", "dashboard/app.py", "--server.port", "8501", "--server.address", "0.0.0.0"]
