# FastAPI serving layer (api service)
FROM python:3.12-slim

RUN pip install --no-cache-dir pandas numpy pyarrow fastapi "uvicorn[standard]" PyYAML

WORKDIR /opt/app
COPY common/ ./common/
COPY api/ ./api/

ENV PYTHONUNBUFFERED=1
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
